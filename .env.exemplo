# ────────────────────────────────────────────────────────────────────────────
# CONFIGURAÇÃO DO CRM
#
# Copie este arquivo para `.env` e preencha. O instalador (`npm run instalar`)
# faz isso sozinho e é o caminho recomendado: ele confere cada chave falando com
# o serviço de verdade antes de gravar, em vez de deixar você descobrir um erro
# de digitação três telas depois.
#
# `.env` NUNCA vai para o Git. Já está no .gitignore.
# ────────────────────────────────────────────────────────────────────────────


# ── SUPABASE, o banco e o login ─────────────────────────────────────────────
#
# Pegue em: app.supabase.com > seu projeto > Settings > API

# O endereço do projeto. Algo como https://abcdefgh.supabase.co
SUPABASE_URL=
VITE_SUPABASE_URL=

# A chave pública ("anon" / "publishable"). Ela é PARA aparecer no navegador:
# quem protege os dados é o RLS do banco, não o segredo dela.
VITE_SUPABASE_ANON_KEY=

# A chave de serviço ("service_role" / "secret"). Esta ignora TODO o RLS.
# Ela fica só no servidor. Se ela aparecer no navegador uma única vez, está
# queimada: qualquer pessoa abre a aba de rede, copia, e passa a ler e apagar
# o banco inteiro. Não existe VITE_ para ela, e é de propósito.
SUPABASE_SERVICE_ROLE_KEY=


# ── A API ───────────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development

# Onde a tela roda. O backend só aceita chamada vinda daqui.
CORS_ORIGIN=http://localhost:5183
APP_URL=http://localhost:5183

# Onde a API responde, do ponto de vista da tela.
VITE_API_URL=http://localhost:4000
PUBLIC_API_URL=http://localhost:4000


# ── UAZAPI, o canal de WhatsApp ─────────────────────────────────────────────
#
# Pegue no painel da uazapi depois de criar a conta.

# O endereço do seu servidor. Algo como https://SEUNOME.uazapi.com
UAZAPI_SERVER=

# O token de administrador. Ele cria e apaga instâncias: trate como senha.
UAZAPI_ADMIN_TOKEN=


# ── A PONTE, quem fala com o WhatsApp ───────────────────────────────────────

WHATSAPP_BRIDGE_PORT=4200
WHATSAPP_BRIDGE_URL=http://localhost:4200
BACKEND_URL=http://localhost:4000

# Uma senha que VOCÊ inventa. É ela que separa "webhook do meu provedor" de
# "qualquer um na internet mandando mensagem falsa para o meu CRM".
# O instalador gera uma sozinho. Se for preencher na mão, use algo longo e
# aleatório, nunca o nome da empresa.
WHATSAPP_BRIDGE_TOKEN=

# O endereço público por onde o provedor entrega as mensagens recebidas.
#
# Em desenvolvimento, `npm run tunel` levanta um endereço temporário e escreve
# ele sozinho: deixe em branco. Em produção, ponha o seu domínio fixo.
#
# LEIA ISTO: um endereço público que parou de responder é a falha mais cara
# deste sistema, porque ela não dá erro. O número continua pareado, a tela
# continua verde, o envio continua saindo, e nada do que o cliente responde
# chega. Por isso a tela tem o sinal "Automação ativa", e por isso produção
# pede domínio fixo em vez de túnel.
WHATSAPP_BRIDGE_PUBLIC_URL=
